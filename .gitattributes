# Force consistent line endings across Windows, macOS, and Linux
# contributors. Without this, every cross-OS edit shows up as a
# whole-file diff (CRLF <-> LF), drowning real changes.
#
# Strategy: store everything as LF in the repo; let Windows checkouts
# convert to CRLF on the fly if Git's core.autocrlf is enabled.

# Default: detect text vs binary, normalise text to LF.
* text=auto eol=lf

# Windows-only scripts that must stay CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Source files — explicit so nothing slips through detection.
*.dart      text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.gradle    text eol=lf
*.kts       text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.arb       text eol=lf
*.txt       text eol=lf
*.rules     text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary files — never line-end-converted, never line-diffed.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tgz       binary
*.jar       binary
*.aab       binary
*.apk       binary
*.keystore  binary
*.jks       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
